{
  "name": "fungarium",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/build-content.mjs && vite --host 127.0.0.1",
    "build": "node scripts/build-content.mjs && vite build",
    "build:encyclopedia": "node scripts/build-content.mjs && vite build --base=/encyclopedia/",
    "preview": "vite preview --host 127.0.0.1",
    "preview:encyclopedia": "vite preview --host 127.0.0.1 --base=/encyclopedia/",
    "content": "node scripts/build-content.mjs",
    "audit:metadata": "node scripts/audit-metadata.mjs",
    "audit:bundle": "node scripts/bundle-report.mjs",
    "audit:characteristics": "node scripts/audit-characteristics.mjs",
    "audit:lighthouse": "node scripts/lighthouse/run.mjs",
    "import:instagram": "node scripts/import-instagram.mjs",
    "photos:instagram": "node scripts/fetch-instagram-photos.mjs",
    "test": "node --test tests/*.test.mjs",
    "coverage": "node scripts/coverage/run.mjs all",
    "coverage:node": "node scripts/coverage/run.mjs node",
    "coverage:ui": "node scripts/coverage/run.mjs browser",
    "coverage:summary": "node scripts/coverage/summary.mjs",
    "test:ui": "playwright test",
    "test:a11y": "npm run build:encyclopedia && playwright test --config=playwright.accessibility.config.js",
    "test:subpath": "npm run build:encyclopedia && playwright test --config=playwright.subpath.config.js"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/libre-caslon-display": "^5.3.0",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/compiler-sfc": "^3.5.44",
    "chrome-launcher": "^1.2.2",
    "lighthouse": "^13.5.0",
    "monocart-coverage-reports": "^3.0.0",
    "sharp": "^0.35.5",
    "vite": "^7.1.9"
  }
}
